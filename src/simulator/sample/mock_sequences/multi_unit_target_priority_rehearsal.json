        "hp": 180,
        "max_hp": 200,
        "x": 2360,
        "y": 900
      }
    },
    {
      "at_sec": 0.5,
      "command": "set_unit",
      "payload": {
        "side": "enemy",
        "type": "Engineer",
        "hp": 250,
        "max_hp": 250,
        "x": 2235,
        "y": 520
      }
    },
    {
      "at_sec": 0.6,
      "command": "set_unit",
      "payload": {
        "side": "enemy",
        "type": "Infantry2",
        "hp": 150,
